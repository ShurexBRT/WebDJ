{
  "name": "WebDJ Studio",
  "short_name": "WebDJ",
  "description": "A local-first browser DJ workstation with two decks, mixer, effects, recording and controller support.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "landscape",
  "background_color": "#030405",
