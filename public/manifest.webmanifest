  "icons": [
    {
      "src": "icons/webdj.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/webdj-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Open music library",
      "short_name": "Library",
      "url": "./#library-dock"
    },
    {
      "name": "Open mix recorder",
